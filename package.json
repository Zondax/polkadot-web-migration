{
  "name": "polkadot-migration",
  "version": "0.0.1",
  "private": true,
  "description": "Polkadot Migration",
  "keywords": [
    "zondax",
    "polkadot"
  ],
  "license": "Apache-2.0",
  "author": "Zondax AG <hello@zondax.ch>",
  "scripts": {
    "build": "next build",
    "build:docker": "docker build -t polkadot-migration .",
    "check": "biome check --write --unsafe .",
    "deps:update": "pnpm exec npm-check-updates -u -t semver && pnpm install",
    "dev": "NEXT_PUBLIC_NODE_ENV=development NEXT_PUBLIC_NATIVE_TRANSFER_AMOUNT=100 next dev --turbo",
    "dev:full-amount": "NEXT_PUBLIC_NODE_ENV=development next dev",
    "env:init": "cp .env.backup .env",
    "format": "biome format --write . && sort-package-json",
    "format:check": "biome format . && sort-package-json -c",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "prepare-pr": "pnpm install && pnpm exec playwright install && pnpm format && pnpm lint:fix && pnpm build && pnpm test && pnpm test:e2e",
    "start": "next start",
    "start:docker": "PORT=${PORT:-3000} && docker run --rm -p $PORT:3000 polkadot-migration",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e",
    "test:e2e:debug": "playwright test e2e --debug",
    "test:e2e:install": "playwright install",
    "test:e2e:report": "playwright show-report",
    "test:e2e:sharding": "playwright test e2e -x --reporter=list --output=playwright-report --shard=$PLAYWRIGHT_SHARD",
    "test:e2e:ui": "playwright test e2e --ui",
    "test:patterns": "./tests/lint-test-patterns.sh",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@ledgerhq/errors": "^6.37.0",
    "@ledgerhq/hw-transport": "^6.36.0",
    "@ledgerhq/hw-transport-mocker": "^6.35.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@ledgerhq/types-live": "^6.123.0",
    "@legendapp/state": "^3.0.0-beta.48",
    "@polkadot-api/merkleize-metadata": "^1.3.1",
    "@polkadot/api": "^16.5.6",
    "@polkadot/api-derive": "^16.5.6",
    "@polkadot/keyring": "^13.5.9",
    "@polkadot/types": "^16.5.6",
    "@polkadot/types-augment": "^16.5.6",
    "@polkadot/types-codec": "^16.5.6",
    "@polkadot/util": "^13.5.9",
    "@polkadot/util-crypto": "^13.5.9",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^1.6.1",
    "@zondax/ledger-js": "^1.3.4",
    "@zondax/ledger-substrate": "^2.3.4",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "12.40.0",
    "html-react-parser": "^5.2.17",
    "isomorphic-dompurify": "^2.36.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.559.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "p-queue": "^9.3.3",
    "p-retry": "^8.0.0",
    "postcss": "^8.5.28",
    "prop-types": "^15.8.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "npm:types-react-dom@19.0.0-alpha.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.6.1",
    "globals": "^16.5.0",
    "postcss-nested": "^7.0.2",
    "sort-package-json": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@ledgerhq/hw-transport": "6.35.2",
      "bn.js": ">=5.2.3",
      "dompurify": ">=3.4.13",
      "undici": "^7.29.0",
      "uuid": ">=11.1.1",
      "ws": ">=8.21.0"
    }
  }
}
